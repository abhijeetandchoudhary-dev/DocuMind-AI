# Copy this file to .env and fill in any keys you want to use.
# Any provider can also be selected at runtime via the sidebar.

# --- Cloud LLM providers (all optional; app also works fully offline) ---
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
TOGETHER_API_KEY=

# --- Local LLM via Ollama (https://ollama.com) ---
# Start the server with: ollama serve
# Pull a model with:    ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_NUM_CTX=8192

# --- Optional model overrides for cloud providers ---
# GROQ_MODEL=llama-3.1-8b-instant
# TOGETHER_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Optional tuning ---
# EMBEDDING_MODEL=BAAI/bge-m3   # faster, smaller: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# CHUNK_SIZE=220
# CHUNK_OVERLAP=40
# MAX_CONTEXT_CHARS=14000
# OCR_LANGUAGES=eng+ara
# TESSDATA_PREFIX=C:/Program Files/Tesseract-OCR/tessdata   # auto-detected on common install paths
# REQUEST_TIMEOUT=60
# DATA_DIR=data
